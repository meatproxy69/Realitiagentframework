{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Committed observer field projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "units",
    "body_zones",
    "z",
    "x",
    "m",
    "e",
    "g",
    "cc",
    "cf",
    "k",
    "source_contact"
  ],
  "properties": {
