        "type": "string"
      }
    },
    "x": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "items": {
          "type": "number"
        }
      }
    },
    "m": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "enum": [
          0,
          1
        ]
      }
    },
    "e": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "number"
      }
    },
    "g": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "number"
      }
    },
    "cc": {
      "type": [
        "number",
        "null"
      ]
    },
    "cf": {
      "type": [
        "number",
        "null"
      ]
    },
    "k": {
      "type": [
        "integer",
        "null"
      ]
