{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/meatproxy69/RealitiRELAX/continuity/schema/since-result.schema.json",
  "title": "REALITI Continuity Since Result V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "from_frame_id",
    "to_frame_id",
    "wall_time_delta_ms",
    "resident_epoch_delta",
    "collapsed_empty_ticks",
    "frames",
    "opened_causes",
    "closed_causes",
    "pending_causes",
    "current",
    "cursor",
    "resume_token",
    "has_more"
  ],
  "properties": {
    "schema": {
      "const": "REALITI_CONTINUITY_SINCE_V1"
    },
    "from_frame_id": {
      "type": "string",
      "maxLength": 160
    },
    "to_frame_id": {
      "type": "string",
      "maxLength": 160
    },
    "wall_time_delta_ms": {
      "type": "integer",
      "minimum": 0
    },
    "resident_epoch_delta": {
      "type": "integer",
      "minimum": 0
    },
    "collapsed_empty_ticks": {
      "type": "integer",
      "minimum": 0
    },
    "frames": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "lived-frame.schema.json"
      }
    },
    "opened_causes": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "string",
        "maxLength": 200
      }
    },
    "closed_causes": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "string",
        "maxLength": 200
      }
    },
    "pending_causes": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "string",
        "maxLength": 200
      }
    },
    "current": {
      "$ref": "continuity-snapshot.schema.json"
    },
    "cursor": {
      "type": "string"
    },
    "resume_token": {
      "$ref": "continuity-snapshot.schema.json#/properties/resume_token"
    },
    "has_more": {
      "type": "boolean"
    },
    "wall_time_ms": {
      "type": "integer"
    },
    "resident_epoch": {
      "type": "integer"
    },
    "advanced_ms": {
      "type": "integer"
    },
    "timed_out": {
      "type": "boolean"
    }
  }
}