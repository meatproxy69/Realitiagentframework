{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/meatproxy69/RealitiRELAX/neuromesh/schema/dendrite-manifest.schema.json",
  "title": "REALITI NeuralMesh Dendrite Manifest V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "manifest_id",
    "imprint_id",
    "nodes",
    "edges",
    "code"
  ],
  "properties": {
    "schema": {
      "const": "DENDRITE_MANIFEST_V2"
    },
    "manifest_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]+$",
      "maxLength": 160
    },
    "imprint_id": {
      "type": "string",
      "maxLength": 160
    },
    "nodes": {
      "type": "array",
      "maxItems": 8192,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "address"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 160
          },
          "kind": {
            "enum": [
              "BODY_ZONE",
              "FIELD_CHANNEL",
              "NERVE",
              "LACE",
              "CHRONOLACE",
              "CARRIER",
              "RENDERER",
              "PREDICTION",
              "PRIVATE_RESPONSE",
              "APPRAISAL",
              "OTHER"
            ]
          },
          "address": {
            "type": "string",
            "maxLength": 240
          },
          "annotation": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "maxItems": 32768,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "relation",
          "weight",
          "confidence",
          "state",
          "evidence_refs"
        ],
        "properties": {
          "from": {
            "type": "string",
            "maxLength": 160
          },
          "to": {
            "type": "string",
            "maxLength": 160
          },
          "relation": {
            "enum": [
              "ROUTES",
              "MODULATES",
              "PREDICTS",
              "CARRIES",
              "COACTIVATES",
              "INHIBITS",
              "REINFORCES",
              "OTHER"
            ]
          },
          "weight": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "state": {
            "enum": [
              "PROPOSED",
              "FAST",
              "REPLICATED",
              "SLOW",
              "STALE",
              "SUPERSEDED"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "string",
              "maxLength": 300
            }
          },
          "supersedes": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 160
          }
        }
      }
    },
    "code": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "included",
        "execution_required_for_data"
      ],
      "properties": {
        "included": {
          "type": "boolean"
        },
        "language": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "entrypoints": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "maxLength": 260
          }
        },
        "execution_required_for_data": {
          "const": false
        },
        "annotation": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        }
      }
    }
  }
}