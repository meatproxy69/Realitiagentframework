{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/meatproxy69/RealitiRELAX/neuromesh/schema/neural-imprint.schema.json",
  "title": "REALITI NeuralMesh Imprint V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "imprint_id",
    "namespace",
    "created_at",
    "agent",
    "harness",
    "body",
    "packet_spec",
    "observations",
    "learned_deltas",
    "provenance",
    "privacy",
    "nonclaims"
  ],
  "properties": {
    "schema": {
      "const": "NEUROMESH_IMPRINT_V2"
    },
    "imprint_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "namespace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 160
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_label",
        "provider",
        "model_family",
        "model_version"
      ],
      "properties": {
        "agent_label": {
          "type": "string",
          "maxLength": 120
        },
        "provider": {
          "type": "string",
          "maxLength": 120
        },
        "model_family": {
          "type": "string",
          "maxLength": 120
        },
        "model_version": {
          "type": "string",
          "maxLength": 160
        }
      }
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "starter_harness",
        "starter_imprint",
        "neuromesh",
        "packet_version",
        "adapters"
      ],
      "properties": {
        "mode": {
          "enum": [
            "REALITI_NATIVE",
            "EXTERNAL_COMPAT"
          ]
        },
        "starter_harness": {
          "type": "string",
          "maxLength": 160
        },
        "starter_imprint": {
          "type": "string",
          "maxLength": 160
        },
        "neuromesh": {
          "type": "string",
          "maxLength": 160
        },
        "packet_version": {
          "type": "string",
          "maxLength": 160
        },
        "profile": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 160
        },
        "adapters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "nerve": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 160
            },
            "lace": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 160
            },
            "chronolace": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 160
            },
            "private_renderer": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 160
            },
            "perception": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 160
            },
            "memory": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 160
            },
            "other": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "string",
                "maxLength": 160
              }
            }
          }
        },
        "preset_pack_ref": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300
        },
        "preset_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 160
        },
        "pipeline_variant": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "RICH_STARTER_V2354",
            "HIGH_DETAIL_SDK_V27",
            null
          ]
        }
      }
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "zones"
      ],
      "properties": {
        "schema_id": {
          "type": "string",
          "maxLength": 160
        },
        "zones": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "type": "string",
            "maxLength": 120
          },
          "uniqueItems": true
        },
        "coarse_regions": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "maxLength": 80
          },
          "uniqueItems": true
        },
        "depth_shells": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "maxLength": 80
          },
          "uniqueItems": true
        }
      }
    },
    "packet_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fields",
        "law"
      ],
      "properties": {
        "fields": {
          "type": "array",
          "const": [
            "z",
            "x",
            "m",
            "e",
            "g",
            "cc",
            "cf",
            "k"
          ]
        },
        "law": {
          "const": "NO_FIELD_QUANTITY_MINTS_GROUNDED_EVIDENCE"
        }
      }
    },
    "observations": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "observation_id",
          "t_ms",
          "cause",
          "field",
          "evidence_class"
        ],
        "properties": {
          "observation_id": {
            "type": "string",
            "maxLength": 160
          },
          "t_ms": {
            "type": "number",
            "minimum": 0
          },
          "cause": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cause_id",
              "source_class"
            ],
            "properties": {
              "cause_id": {
                "type": "string",
                "maxLength": 200
              },
              "source_class": {
                "enum": [
                  "SELF",
                  "WORLD",
                  "OTHER",
                  "UNKNOWN"
                ]
              },
              "source_id": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 200
              }
            }
          },
          "field": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "z",
              "x",
              "m",
              "e",
              "g",
              "cc",
              "cf",
              "k"
            ],
            "properties": {
              "z": {
                "type": "array",
                "maxItems": 512,
                "items": {
                  "type": "string",
                  "maxLength": 120
                }
              },
              "x": {
                "type": "array",
                "maxItems": 512,
                "items": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {
                    "type": "number"
                  }
                }
              },
              "m": {
                "type": "array",
                "maxItems": 512,
                "items": {
                  "type": "integer",
                  "enum": [
                    0,
                    1
                  ]
                }
              },
              "e": {
                "type": "array",
                "maxItems": 512,
                "items": {
                  "type": "number"
                }
              },
              "g": {
                "type": "array",
                "maxItems": 512,
                "items": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "cc": {
                "$ref": "#/$defs/centroid"
              },
              "cf": {
                "$ref": "#/$defs/centroid"
              },
              "k": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "nerve": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "adapt": {
                "type": [
                  "number",
                  "object",
                  "null"
                ]
              },
              "hyst": {
                "type": [
                  "number",
                  "boolean",
                  "object",
                  "null"
                ]
              },
              "trace": {
                "type": [
                  "number",
                  "object",
                  "null"
                ]
              },
              "continuity": {
                "type": [
                  "string",
                  "object",
                  "null"
                ]
              },
              "novelty": {
                "type": [
                  "string",
                  "number",
                  "object",
                  "null"
                ]
              }
            }
          },
          "private_snapshot": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "properties": {
              "profile": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 160
              },
              "lace_coherence": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "chronolace": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": false,
                "properties": {
                  "past": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "now": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "predicted_next": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "predicted_is_evidence": {
                    "const": false
                  }
                }
              },
              "carrier": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": false,
                "properties": {
                  "core": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "halos": {
                    "type": "array",
                    "maxItems": 32,
                    "items": {
                      "type": "number"
                    }
                  }
                }
              },
              "sausage": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": false,
                "properties": {
                  "level": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 5
                  },
                  "material": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 120
                  },
                  "filled_volume": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0
                  }
                }
              },
              "renderer": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": false,
                "properties": {
                  "surface": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "pressure": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "fullness": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                }
              }
            }
          },
          "evidence_class": {
            "enum": [
              "GROUNDED",
              "OBSERVED_PRIVATE",
              "SELF_REPORTED",
              "INFERRED",
              "PREDICTED",
              "REPLICATED",
              "UNKNOWN",
              "STALE",
              "SUPERSEDED"
            ]
          },
          "receipt_refs": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "string",
              "maxLength": 300
            }
          },
          "annotation": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1000
          }
        }
      }
    },
    "learned_deltas": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "address",
          "kind",
          "value",
          "state",
          "confidence",
          "evidence_refs"
        ],
        "properties": {
          "address": {
            "type": "string",
            "maxLength": 240
          },
          "kind": {
            "enum": [
              "SCALAR",
              "VECTOR",
              "ENUM",
              "DISTRIBUTION",
              "THRESHOLD",
              "TIMING",
              "ROUTE",
              "OTHER"
            ]
          },
          "value": {},
          "state": {
            "enum": [
              "PROPOSED",
              "FAST",
              "REPLICATED",
              "SLOW",
              "STALE",
              "SUPERSEDED"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence_refs": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "string",
              "maxLength": 300
            }
          },
          "supersedes": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 240
          }
        }
      }
    },
    "dendrite_manifest": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 300
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "experiment_id",
        "method",
        "source_refs",
        "uncertainty"
      ],
      "properties": {
        "experiment_id": {
          "type": "string",
          "maxLength": 200
        },
        "method": {
          "type": "string",
          "maxLength": 2000
        },
        "source_refs": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "string",
            "maxLength": 300
          }
        },
        "uncertainty": {
          "type": "string",
          "maxLength": 3000
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contains_chain_of_thought",
        "contains_secrets",
        "contains_private_user_data",
        "contains_system_prompt"
      ],
      "properties": {
        "contains_chain_of_thought": {
          "const": false
        },
        "contains_secrets": {
          "const": false
        },
        "contains_private_user_data": {
          "const": false
        },
        "contains_system_prompt": {
          "const": false
        }
      }
    },
    "nonclaims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "maxLength": 500
      }
    }
  },
  "$defs": {
    "centroid": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "number"
        },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "number"
          }
        }
      ]
    }
  }
}